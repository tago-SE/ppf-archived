{
	"compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "Bundler",
		"strict": true,
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"esModuleInterop": true,
        "skipLibCheck": true,
        "incremental": true,
		"isolatedModules": true,
        "outDir": "dist",
        "paths": {
            "~/*": ["./src/*"]
        }
	},
    "include": ["src"],
    "exclude": ["dist", "assets"]
}