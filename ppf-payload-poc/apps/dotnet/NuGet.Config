<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="IfCommonPackages" value="https://pkgs.dev.azure.com/if-it/_packaging/If-Common-Packages-global/nuget/v3/index.json" />
    <add key="Centalog" value="https://if-it.pkgs.visualstudio.com/common-Centalog/_packaging/Centalog/nuget/v3/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <IfCommonPackages>
      <add key="Username" value="dealerServices" />
      <add key="ClearTextPassword" value="%Nuget_CustomFeedPassword%" />
    </IfCommonPackages>
	  <Centalog>
      <add key="Username" value="dealerServices" />
      <add key="ClearTextPassword" value="%Nuget_CustomFeedPassword%" />
    </Centalog>
  </packageSourceCredentials>
</configuration>