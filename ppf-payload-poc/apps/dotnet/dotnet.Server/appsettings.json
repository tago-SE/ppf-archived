{
  "Application": {
    "Identity": {
      "ClientId": ""
    }
  },
  "Payload": {
    "TenantSlug": "",
    "AuthStrategy":  ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": null
  },
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "cluster1",
