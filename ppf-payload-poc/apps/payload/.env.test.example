##########
#   Testing Env Variables
##########
TEST_CURITY_CLIENT_ID=<curity-client>
TEST_CURITY_CLIENT_SECRET=<curity-secret>

##########
#   Payload Env Variables
##########

# NOTE: Change port of `PAYLOAD_PUBLIC_SITE_URL` if front-end is running on another server
PAYLOAD_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DATABASE_URI=mongodb://127.0.0.1/<databasename>
DATABASE_SSL=0
DATABASE_DEBUG_LOGGER=0
PAYLOAD_SECRET=PAYLOAD_AUTH_EXAMPLE_SECRET_KEY
##################################################################################
### Curity
##################################################################################
NEXTAUTH_DEBUG=0
AUTH_URL=http://localhost:3000
OAUTH2_CLIENT_ID=<client>
OAUTH2_CLIENT_SECRET=<secret>
OAUTH2_CLIENT_SCOPE="openid profile offline_access"
OAUTH2_ISSUER=https://authdev.ifext.biz
##################################################################################
### Groups 
##################################################################################
# Note:
# 1) ClientId, TenantId and ClientSecret are optional locally.
# 2) If secret and tenant is missing it will try using the ManagedIdeneity.
# 3) ClientId is referencing the ManagedIdentity of the CA.
MSGRAPH_CLIENT_ID=da4da8c0-3cb3-4562-afd9-f6ac7c895375
MSGRAPH_TENANT_ID=de7e7a67-ae61-49d2-97a7-526c910ad675
MSGRAPH_CLIENT_SECRET=<secret>
MSGRAPH_CLIENT_DEBUG=false
#
MSGRAPH_GROUPID_FOR_SUPERADMIN=0260419f-d8ca-4eda-a5fa-04e81875467b
MSGRAPH_GROUPID_FOR_CMS_LOGIN=8191f873-32f5-4405-a703-45e6db2856d7
###################################################################
# ImageShop
IMAGESHOPAPIKEY=
##################################################################################
### Logging 
##################################################################################
NEXT_PUBLIC_APPLICATIONINSIGHTS_DISABLE_COOKIES=false
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
##################################################################################

AZURE_STORAGE_ALLOW_CONTAINER_CREATE=true
AZURE_STORAGE_ACCOUNT_BASEURL=https://ppfstoragedev.blob.core.windows.net/
AZURE_STORAGE_CONTAINER_NAME=media