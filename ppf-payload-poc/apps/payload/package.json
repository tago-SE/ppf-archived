{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "Payload authentication example.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "dev:https": "cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-https",
    "dev:seed": "cross-env yarn seed && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:graphQLSchema": "payload-graphql generate:schema",
    "generate:types": "cross-env payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "seed": "payload run ./src/seed/index.ts",
    "seed:dev": "cross-env DEPLOYED_ENV=dev DATABASE_URI=postgres://GA_AISPPAT_SQL_Admins_Test:@ppf-payloadcms-dev-psql.postgres.database.azure.com:5432/postgres AZURE_STORAGE_ACCOUNT_BASEURL=https://ppfpayloadcmsdevst.blob.core.windows.net/ AZURE_STORAGE_CONTAINER_NAME=media payload run ./src/seed/index.ts",
    "seed:test": "cross-env DEPLOYED_ENV=test DATABASE_URI=postgres://GA_AISPPAT_SQL_Admins_Test:@ppf-payloadcms-test-psql.postgres.database.azure.com:5432/postgres AZURE_STORAGE_ACCOUNT_BASEURL=https://ppfpayloadcmstestst.blob.core.windows.net/ AZURE_STORAGE_CONTAINER_NAME=media payload run ./src/seed/index.ts",
    "openapi": "payload run ./src/plugins/payload-oapi/scripts/generate-definitions.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "migrate": "payload run ./migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:integration": "vitest run --config=__test__/vitest.config.ts",
    "test:integration:watch": "vitest watch --config=__test__/vitest.config.ts"
  },
  "dependencies": {
    "@azure/abort-controller": "^1.1.0",
    "@azure/identity": "4.8.0",
    "@azure/logger": "1.1.4",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.27",
    "@azure/storage-blob": "^12.11.0",
    "@microsoft/applicationinsights-clickanalytics-js": "^3.3.4",
    "@microsoft/applicationinsights-react-js": "^17.3.4",
    "@microsoft/applicationinsights-web": "^3.3.4",
    "@microsoft/microsoft-graph-client": "latest",
    "@openapi-contrib/json-schema-to-openapi-schema": "^3.0.3",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@payloadcms/db-postgres": "3.37.0",
    "@payloadcms/graphql": "3.37.0",
    "@payloadcms/next": "3.37.0",
    "@payloadcms/plugin-multi-tenant": "3.37.0",
    "@payloadcms/plugin-nested-docs": "3.37.0",
    "@payloadcms/plugin-search": "3.37.0",
    "@payloadcms/plugin-seo": "3.37.0",
    "@payloadcms/richtext-lexical": "3.37.0",
    "@payloadcms/richtext-slate": "3.37.0",
    "@payloadcms/storage-azure": "3.37.0",
    "@payloadcms/ui": "3.37.0",
    "@types/pluralize": "^0.0.33",
    "@vercel/otel": "^1.10.0",
    "async-lock": "latest",
    "cross-env": "^7.0.3",
    "drizzle-orm": "0.36.1",
    "escape-html": "^1.0.3",
    "graphql": "^16.9.0",
    "jose": "latest",
    "lodash": "^4.17.21",
    "next": "15.2.4",
    "next-auth": "^5.0.0-beta.25",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "openapi-types": "^12.1.0",
    "payload": "3.37.0",
    "pluralize": "^8.0.0",
    "qs-esm": "^7.0.2",
    "range-parser": "^1.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.51.3",
    "slate": "^0.110.2",
    "zlib": "^1.0.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.2.4",
    "@swc/core": "^1.6.13",
    "@swc/types": "^0.1.6",
    "@types/async-lock": "latest",
    "@types/escape-html": "^1.0.4",
    "@types/lodash": "^4",
    "@types/node": "^20.11.25",
    "@types/node-cron": "^3",
    "@types/range-parser": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.14",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-json-schema": "latest",
    "vite": "^6.2.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
